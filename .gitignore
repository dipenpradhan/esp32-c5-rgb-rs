# Build artifacts
.embuild/
esp32-build/build/
esp32-build/*.bin
esp32-build/*.elf
esp32-build/*.map

# ESP-IDF generated files
esp32-build/esp-idf/

# Logs
esp32-build/build/log/
esp32-build/build/*.log

# SDK config backups
esp32-build/sdkconfig.old
esp32-build/.config_*

# CMake cache
esp32-build/build/CMakeCache.txt
esp32-build/build/Makefile
esp32-build/build/compilation_database.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings/state (machine-specific, not shared)
.claude/

# OS files
.DS_Store
Thumbs.db

# AI files
.ai_files

# Subagent artifacts (debug output)
.pi-subagents/
.pi

# Rust build artifacts (if any)
target/
*.rs.bk
serial_simulator/.cargo/
serial_simulator/Cargo.lock

# Node.js / TypeScript build (the single-file web/dist/index.html is a
# firmware build input — it is tracked; see web/.gitignore for the rules)
web/node_modules/

# Watchdog / runtime
watchdog.log
watchdog.sh
.watchdog_state
# Local forks (separate git repos; pushed to GitHub independently)
# Build needs forks/esp-radio present locally via [patch."https://github.com/esp-rs/esp-hal"]
forks/
# WiFi credentials (real values live in configs/wifi.json and are compiled into
# the firmware — never commit; copy configs/wifi.json.example and fill it in)
configs/wifi.json
